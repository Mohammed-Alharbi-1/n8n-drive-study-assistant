        "query": "INSERT INTO processed_files (\n    file_id,\n    file_name,\n    mime_type,\n    output_file_id\n)\nVALUES (\n    $1,\n    $2,\n    $3,\n    $4\n)\nON CONFLICT (file_id)\nDO NOTHING;",
        "options": {
          "queryReplacement": "=$1={{ $('Normalize File Metadata').item.json.file_id }} $2={{ $('Normalize File Metadata').item.json.file_name }} $3={{ $('Normalize File Metadata').item.json.mime_type }} $4={{ $('Upload Study Guide').item.json.id }}"
        }
      },
